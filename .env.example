# The anon key is shipped to the browser and must be treated as public.
# Security is enforced by RLS in Postgres, never by hiding this value.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# NEVER add SUPABASE_SERVICE_ROLE_KEY here or anywhere under src/.
# It belongs only in Edge Function secrets. scripts/check-no-service-key.sh
# fails the build if it leaks into the bundle.
